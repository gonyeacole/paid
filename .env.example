# Google Ads API credentials — see README.md for how to obtain each of these.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
# Needed if GOOGLE_ADS_CUSTOMER_ID is a client account under an MCC (manager) account.
# Also required for budget tracking (MCC-wide), where this is *your MCC's own* 10-digit ID.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
